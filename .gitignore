# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# --- Node / frontend ---
node_modules/
dist/
# Vite builds the frontend straight into where FastAPI serves it from.
backend/static/
# Playwright output: regenerated by "npm run test:e2e" and "npm run shots".
frontend/e2e/.artifacts/
frontend/e2e/.shots/
frontend/playwright-report/
.vite/

# --- Editors / OS ---
.obsidian/
.vscode/
.idea/
Thumbs.db
desktop.ini
*~

# --- Runtime output ---
# Everything this tool writes is a .csv, and a user's own measurements very
# often are too. Ignored by default so that a file dropped in the project
# directory cannot be committed by an absent-minded `git add -A`. The test
# fixtures are the one exception, and they are .txt in practice.
*.csv
!backend/tests/data/*.csv

# The same hazard in the formats a measurement actually arrives in. The two
# fixtures are named explicitly rather than the directory, so that a stray file
# alongside them is still ignored.
*.dat
*.tsv
/*.txt
!backend/tests/data/weak_coupling_clean_hc2.txt
!backend/tests/data/strong_coupling_dirty_kappa.txt

# --- Packaging ---
# PyInstaller output. Rebuilt by packaging/build.ps1, and the executable is
# 54 MB, which is not a thing to keep ten copies of in history.
packaging/build/
packaging/dist/